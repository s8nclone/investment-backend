# Database configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fusion_db?schema=public"

# Server environment & port configuration
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# JWT Authentication secrets and expiry
JWT_SECRET=super_secret_jwt_access_token_key_change_in_production_12345
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production_12345
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing
BCRYPT_ROUNDS=12

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5
